PORT=5000
# Set to "production" when deployed (enables secure cross-site refresh cookies)
NODE_ENV=development
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Emails (verification codes, password resets, manager approvals) are sent through Brevo's API.
# Brevo dashboard > SMTP & API > API Keys. This is the API key, not the SMTP key.
BREVO_API_KEY=your_brevo_api_key
# Must be a sender address verified in Brevo (Senders, Domains & Dedicated IPs > Senders)
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=RENT A HOME


# Frontend address: used in email links and allowed by CORS.
# Several origins can be comma-separated; the first one is used in email links.
FRONTEND_URL=http://localhost:5173

# Image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: used by `npm run create-admin` when no arguments are given
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
